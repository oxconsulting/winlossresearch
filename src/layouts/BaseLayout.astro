---
/**
 * src/layouts/BaseLayout.astro
 *
 * CHANGES FROM PRIOR VERSION (homepage build session):
 * 1. Adds `pillars` and `faqs` props, passed through to buildPageGraph()
 *    when pageGraphType="home" — enables the homepage ItemList and
 *    homepage-scoped FAQPage entities added in schema.ts. Both are
 *    optional and ignored for every other pageGraphType.
 * 2. Splits the previous combined home/list fallback branch into two,
 *    matching the split in PageGraphOptions (schema.ts). 'list' behavior
 *    is unchanged from before.
 * 3. NOTE: pageGraphType still defaults to 'list', not 'home' (see prior
 *    comment below, item 6, for the general default-vs-doc-comment history
 *    on this prop). The homepage must pass pageGraphType="home" explicitly
 *    or it silently gets the generic list graph with no pillars/faqs.
 *
 * CHANGES FROM PRIOR VERSION (before this session):
 * 1. Imports buildPageGraph from utils/schema — pass graph prop to <Seo>
 * 2. Adds <link rel="sitemap"> and <link rel="alternate" rss> to extraLinks
 * 3. Fixes title template so homepage doesn't double site name
 * 4. Adds <ClientRouter> for viewport prefetch
 * 5. Suppresses redundant Twitter tags (OG fallback handles it)
 * 6. ogType defaults to 'article' for content pages; callers can override
 * 7. 'article' pageGraphType branch no longer requires publishDate to fire —
 *    pillar pages have no publishDate field (evergreen content, by design)
 *    and were previously falling through to the generic 'list' graph.
 *
 * USAGE EXAMPLE (pillar page):
 *   <BaseLayout
 *     title="Why Internal Win/Loss Data Fails"
 *     description="CRM notes, rep debriefs..."
 *     canonicalUrl={Astro.url.href}
 *     ogType="article"
 *     breadcrumbs={[{ name: 'Topics', url: 'https://winlossresearch.com/topics/' }, { name: 'Why Internal Win/Loss Data Fails', url: 'https://winlossresearch.com/topics/why-internal-win-loss-data-fails/' }]}
 *     pageGraphType="article"
 *   >
 *     <slot />
 *   </BaseLayout>
 *
 * USAGE EXAMPLE (homepage):
 *   <BaseLayout
 *     title="Complete Reference for Win/Loss Analysis"
 *     description="The complete reference on win/loss analysis, research, and program design for Executive, PMM, and CI teams at B2B SaaS and technology companies."
 *     canonicalUrl={Astro.url.href}
 *     pageGraphType="home"
 *     pillars={pillars}
 *     faqs={faqs}
 *   >
 *     <slot />
 *   </BaseLayout>
 */
import Seo from '@jdevalk/astro-seo-graph/Seo.astro';
import { ClientRouter } from 'astro:transitions';
import { buildPageGraph, SITE_URL, SITE_NAME, type PageGraphOptions } from '../utils/schema';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  /**
   * Open Graph type. Defaults to 'website' for index/list pages; pass 'article'
   * for pillar pages, Perspectives posts, FAQ pages, and glossary pages.
   */
  ogType?: 'website' | 'article';
  /**
   * OG image URL. Defaults to the static fallback.
   * Pass a full absolute URL when a per-page OG image exists.
   */
  ogImageUrl?: string;
  /** Optional. Required for Perspectives posts; pillar pages have none. */
  publishDate?: Date;
  modifiedDate?: Date;
  /** Breadcrumb trail, excluding the root. e.g. [{ name: 'FAQ', url: 'https://winlossresearch.com/faq/' }, { name: 'What is...', url: 'https://winlossresearch.com/faq/what-is-.../' }] */
  breadcrumbs?: Array<{ name: string; url: string }>;
  /**
   * Which graph type to build. Matches PageGraphOptions['pageType'].
   * Defaults to 'list' (see note above) — the homepage must pass "home" explicitly.
   */
  pageGraphType?: PageGraphOptions['pageType'];
  /** FAQ-specific: the full question text */
  faqQuestion?: string;
  /** FAQ-specific: the plain-text answer (first paragraph is fine) */
  faqAnswer?: string;
  /** Glossary-specific: the term name */
  termName?: string;
  /** Glossary-specific: the term definition */
  termDefinition?: string;
  /** Home-specific: the ten pillars, in display order. Renders as an ItemList entity. */
  pillars?: Array<{ name: string; url: string; description: string }>;
  /** Home-specific: homepage meta-FAQ (about the site itself). Renders as a homepage-scoped FAQPage entity. */
  faqs?: Array<{ question: string; answer: string }>;
  /** Playbook-specific: one entry per H2 on the page, in order, for the HowTo schema's step array. */
  steps?: Array<{ name: string; text: string }>;
  /** Tool-specific: plain-text description of what the tool does, for SoftwareApplication schema. */
  applicationDescription?: string;
  /** Opts this page into a wider <main> (.main--wide in global.css). Default false — every other page keeps the 720px prose width. */
  wide?: boolean;
  noindex?: boolean;
}

/**
 * Maps pageGraphType to the OG route's collection folder name. Only page
 * types with a per-entry OG image get an entry here -- home/list/404
 * pages fall through to the static default.jpg.
 */
const OG_COLLECTION_BY_PAGE_TYPE: Partial<Record<PageGraphOptions['pageType'], string>> = {
  article: 'pillars',
  perspectives: 'perspectives',
  faq: 'faq',
  glossary: 'glossary',
  playbook: 'playbook',
};

function deriveDynamicOgImageUrl(
  pageType: PageGraphOptions['pageType'],
  canonicalUrl: string
): string | null {
  const collection = OG_COLLECTION_BY_PAGE_TYPE[pageType];
  if (!collection) return null;
  // canonicalUrl ends in /[id]/ -- entry.id is always the last non-empty
  // segment (confirmed via getStaticPaths across all five collection
  // templates: params.slug = entry.id in every case, Session C verification).
  const segments = canonicalUrl.replace(/\/$/, '').split('/');
  const id = segments[segments.length - 1];
  return `${SITE_URL}/og/${collection}/${id}.jpg`;
}

const {
  title,
  description,
  canonicalUrl = Astro.url.href,
  ogType = 'website',
  publishDate,
  modifiedDate,
  breadcrumbs,
  pageGraphType = 'list',
  faqQuestion,
  faqAnswer,
  termName,
  termDefinition,
  pillars,
  faqs,
  steps,
  applicationDescription,
  wide = false,
  noindex = false,
} = Astro.props;

const ogImageUrl =
  Astro.props.ogImageUrl ??
  deriveDynamicOgImageUrl(pageGraphType, canonicalUrl) ??
  `${SITE_URL}/og/default.jpg`;

// Build the appropriate graph for this page type
let graphOptions: PageGraphOptions;

if (pageGraphType === 'faq' && faqQuestion && faqAnswer) {
  graphOptions = {
    pageType: 'faq',
    url: canonicalUrl,
    name: title,
    description,
    question: faqQuestion,
    answer: faqAnswer,
    breadcrumbs,
  };
} else if (pageGraphType === 'glossary' && termName && termDefinition) {
  graphOptions = {
    pageType: 'glossary',
    url: canonicalUrl,
    name: title,
    description,
    termName,
    termDefinition,
    breadcrumbs,
  };
} else if (pageGraphType === 'article') {
  // publishDate is optional here — pillar pages have none, Article schema
  // simply omits datePublished/dateModified when absent (see schema.ts)
  graphOptions = {
    pageType: 'article',
    url: canonicalUrl,
    name: title,
    description,
    publishDate,
    modifiedDate,
    breadcrumbs,
    imageUrl: ogImageUrl,
  };
} else if (pageGraphType === 'perspectives' && publishDate) {
  graphOptions = {
    pageType: 'perspectives',
    url: canonicalUrl,
    name: title,
    description,
    publishDate,
    modifiedDate,
    breadcrumbs,
    imageUrl: ogImageUrl,
  };
} else if (pageGraphType === 'playbook' && steps) {
  graphOptions = {
    pageType: 'playbook',
    url: canonicalUrl,
    name: title,
    description,
    steps,
    breadcrumbs,
  };
} else if (pageGraphType === 'home') {
  graphOptions = {
    pageType: 'home',
    url: canonicalUrl,
    name: title,
    description,
    pillars,
    faqs,
  };
} else if (pageGraphType === 'tool' && applicationDescription) {
  graphOptions = {
    pageType: 'tool',
    url: canonicalUrl,
    name: title,
    description,
    applicationDescription,
    breadcrumbs,
  };
} else {
  graphOptions = {
    pageType: 'list',
    url: canonicalUrl,
    name: title,
    description,
  };
}

const graph = buildPageGraph(graphOptions);

// Title suffix: only home/list (index) pages get " | Win/Loss Research".
// Content pages (article/faq/glossary/perspectives) render the bare title —
// the suffix was pushing every content title 20 chars past the build's
// 65-char metadata-length ceiling.
const isContentPage =
  pageGraphType === 'article' ||
  pageGraphType === 'faq' ||
  pageGraphType === 'glossary' ||
  pageGraphType === 'perspectives' ||
  pageGraphType === 'playbook' ||
  pageGraphType === 'tool';
const titleTemplate = isContentPage ? '%s' : `%s | ${SITE_NAME}`;

// For Perspectives posts and dated Article pages: build OG article metadata.
// Pillar pages (no publishDate) simply get no article:published_time tag —
// ogType can still be 'article' without it.
const articleMeta =
  (pageGraphType === 'perspectives' || pageGraphType === 'article') && publishDate
    ? {
        publishedTime: publishDate,
        modifiedTime: modifiedDate ?? publishDate,
        authors: [`${SITE_URL}/about/`],
        section: 'Win/Loss Research',
      }
    : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=IBM+Plex+Mono:wght@400;500;600&family=Source+Serif+4:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <Seo
      title={title}
      titleTemplate={titleTemplate}
      description={description}
      canonical={canonicalUrl}
      ogType={ogType}
      ogImage={ogImageUrl}
      ogImageAlt={`${title} — Win/Loss Research`}
      ogImageWidth={1200}
      ogImageHeight={630}
      siteName={SITE_NAME}
      locale="en_US"
      noindex={noindex}
      article={articleMeta}
      graph={graph}
      extraLinks={[
        { rel: 'icon', type: 'image/svg+xml', href: '/favicon.svg' },
        { rel: 'sitemap', href: '/sitemap-index.xml' },
        { rel: 'alternate', type: 'application/rss+xml', href: '/feed.xml', title: `${SITE_NAME} — Perspectives` },
      ]}
    />
    <slot name="head" />
    <ClientRouter defaultStrategy="viewport" />
  </head>
  <body>
    <header>
      <nav>
        <a href="/" class="logo">
          <span class="badge">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M16 5 L8 12 L16 19" stroke="#1B1E22" stroke-width="3.4"
                    stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            </svg>
          </span>
          <span class="wordmark">Win/Loss Research</span>
        </a>
        <div class="nav-links">
          <a href="/topics/" class:list={[{ active: Astro.url.pathname.startsWith('/topics') }]}>Topics</a>
          <a href="/perspectives/" class:list={[{ active: Astro.url.pathname.startsWith('/perspectives') }]}>Perspectives</a>
          <a href="/faq/" class:list={[{ active: Astro.url.pathname.startsWith('/faq') }]}>FAQ</a>
          <a href="/glossary/" class:list={[{ active: Astro.url.pathname.startsWith('/glossary') }]}>Glossary</a>
          <a href="/playbook/" class:list={[{ active: Astro.url.pathname.startsWith('/playbook') }]}>Playbook</a>
          <a href="/about/" class:list={[{ active: Astro.url.pathname.startsWith('/about') }]}>About</a>
        </div>
      </nav>
    </header>

    <main class:list={[{ 'main--wide': wide }]}>
      <slot />
    </main>

    <footer>
      <div class="footer-inner">
        <a href="/" class="logo">
          <span class="badge">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M16 5 L8 12 L16 19" stroke="#1B1E22" stroke-width="3.4"
                    stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            </svg>
          </span>
          <span class="wordmark">Win/Loss Research</span>
        </a>
        <p class="footer-note">
          © {new Date().getFullYear()} Win/Loss Research. A primary reference from <a href="https://www.oxwinloss.com" rel="noopener">Ox Win/Loss</a>.
        </p>
      </div>
    </footer>
  </body>
</html>
