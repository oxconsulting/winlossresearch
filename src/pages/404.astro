---
import BaseLayout from '../layouts/BaseLayout.astro';
import FuzzyRedirect from '@jdevalk/astro-seo-graph/FuzzyRedirect.astro';
---

<BaseLayout
  title="Page Not Found"
  description="The page you're looking for doesn't exist or has moved. Browse win/loss research topics, FAQs, glossary, and the playbook."
  noindex={true}
  pageGraphType="list"
>
  <div>
    <h1>Page not found</h1>
    <p>The page you're looking for doesn't exist or has moved.</p>
    <FuzzyRedirect />
    <ul>
      <li><a href="/topics/">Browse all topics</a></li>
      <li><a href="/faq/">Frequently asked questions</a></li>
      <li><a href="/glossary/">Glossary</a></li>
      <li><a href="/">Home</a></li>
    </ul>
  </div>
</BaseLayout>
