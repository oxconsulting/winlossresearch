---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PILLAR_SLUGS } from '../../content.config';

const [posts, pillarPages] = await Promise.all([
  getCollection('perspectives'),
  getCollection('pillars'),
]);

const pillarNames = Object.fromEntries(
  pillarPages.map((p) => [p.id, p.data.shortTitle]),
);

// Grouped by primary pillar only (data.pillar) — pillarSecondary is not
// used for grouping, so a dual-pillar post appears once, under its
// primary pillar, not twice.
const groups = PILLAR_SLUGS.map((slug, i) => ({
  slug,
  number: i + 1,
  name: pillarNames[slug] ?? slug,
  items: posts
    .filter((post) => post.data.pillar === slug)
    .sort((a, b) => a.data.title.localeCompare(b.data.title)),
})).filter((group) => group.items.length > 0);
---

<BaseLayout
  title="Perspectives"
  description="Daniel Oxenburgh's point-of-view posts on win/loss research — buyer quotes, client observations, and arguments grounded in independent research."
>
  <h1>Perspectives</h1>
  <p>Argument-driven posts on win/loss research, competitive intelligence, and GTM strategy by Daniel Oxenburgh, Founder of Ox, organized by topic.</p>

  <nav class="jump-nav" aria-label="Jump to a topic">
    <ul>
      {groups.map((group) => (
        <li><a href={`#${group.slug}`}>{group.name}</a></li>
      ))}
    </ul>
  </nav>

  {
    groups.map((group) => (
      <section class="perspectives-group" id={group.slug} aria-labelledby={`${group.slug}-heading`}>
        <h2 id={`${group.slug}-heading`}>
          <a href={`/topics/${group.slug}/`}>{group.name}</a>
        </h2>
        <ul class="index-list">
          {group.items.map((post) => (
            <li>
              <a href={`/perspectives/${post.id}/`}>{post.data.title}</a>
              <p>{post.data.description}</p>
              <time datetime={post.data.publishDate.toISOString()}>
                {post.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</BaseLayout>
