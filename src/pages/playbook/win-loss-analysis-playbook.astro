---
/**
 * src/pages/playbook/win-loss-analysis-playbook.astro
 *
 * Landing page for the compiled Playbook PDF. All 12 individual play
 * pages, the Playbook index, and Pillar 10 link here. Ungated direct
 * download — no email form (see content-architecture.md, Session 27
 * correction). Schema: plain WebPage via pageGraphType="list".
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_URL } from '../../utils/schema';

const phases = [
  {
    label: 'Phase 1',
    title: 'Scope & Design',
    plays: [
      { title: 'How to Scope a Win/Loss Research Program', slug: 'scope-a-win-loss-research-program' },
    ],
  },
  {
    label: 'Phase 2',
    title: 'Recruit & Outreach',
    plays: [
      { title: 'How to Build a Win/Loss Interview Target List', slug: 'build-a-win-loss-interview-target-list' },
      { title: 'How to Get Sales Buy-In for Win/Loss Interview Access', slug: 'get-sales-buy-in-for-win-loss-interviews' },
      { title: 'How to Write a Win/Loss Interview Outreach Sequence', slug: 'write-a-win-loss-interview-outreach-sequence' },
    ],
  },
  {
    label: 'Phase 3',
    title: 'Interview',
    plays: [
      { title: 'How to Design a Win/Loss Interview Questionnaire', slug: 'design-a-win-loss-interview-questionnaire' },
      { title: 'How to Conduct a Win/Loss Interview', slug: 'conduct-a-win-loss-interview' },
    ],
  },
  {
    label: 'Phase 4',
    title: 'Analyze',
    plays: [
      { title: 'How to Code Win/Loss Interview Responses', slug: 'code-win-loss-interview-responses' },
      { title: 'How to Distinguish a Pattern from an Anecdote in Win/Loss Data', slug: 'distinguish-a-pattern-from-an-anecdote' },
    ],
  },
  {
    label: 'Phase 5',
    title: 'Report & Distribute',
    plays: [
      { title: 'How to Deliver a Win/Loss Readout', slug: 'deliver-a-win-loss-readout' },
      { title: 'How to Translate Win/Loss Findings into Function-Specific Actions', slug: 'translate-win-loss-findings-into-function-specific-actions' },
    ],
  },
  {
    label: 'Phase 6',
    title: 'Sustain',
    plays: [
      { title: 'How to Set and Adjust Your Win/Loss Program Cadence', slug: 'set-a-win-loss-program-cadence' },
      { title: 'How to Measure Whether a Win/Loss Program Is Working', slug: 'measure-whether-a-win-loss-program-is-working' },
    ],
  },
];
---
<BaseLayout
  title="Download the Win/Loss Analysis Playbook"
  description="Download the complete Win/Loss Analysis Playbook as a single PDF, covering all twelve plays from scoping a program to sustaining it long-term."
  canonicalUrl={`${SITE_URL}/playbook/win-loss-analysis-playbook/`}
  pageGraphType="list"
>
  <article class="playbook-gate">
    <p class="kicker">Playbook · Free Download</p>
    <h1>The Win/Loss Analysis Playbook</h1>

    <p class="direct-answer">
      The Win/Loss Analysis Playbook is a free 50-page PDF compiling all
      twelve win/loss research plays into a single reference, covering the
      full lifecycle of a program from scoping the first interview cycle
      through measuring whether it's working. Download it directly below —
      no email required.
    </p>

    <div class="pdf-preview">
      <img
        class="pdf-preview__image"
        src="/images/playbook/win-loss-research-playbook-cover.png"
        width="569"
        height="737"
        alt="Cover of The Win/Loss Research Playbook, by Daniel Oxenburgh"
        loading="eager"
      />
      <div class="pdf-preview__copy">
        <h3>What's in the PDF</h3>
        <p class="pdf-preview__meta">50 pages · 12 plays · 6 phases</p>
        <p>
          Every play from the site's Playbook section, compiled in order —
          scoping, recruiting, interviewing, analysis, reporting, and
          program sustainment — with every template, sample questionnaire,
          and worked example included exactly as it appears on the site.
        </p>
        <a class="download-button" href="/downloads/the-win-loss-research-playbook.pdf">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M12 3V15M12 15L7 10M12 15L17 10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M4 17V19C4 20.1046 4.89543 21 6 21H18C19.1046 21 20 20.1046 20 19V17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Download the PDF
        </a>
        <p class="download-note">PDF · 2.5 MB · No email required</p>
      </div>
    </div>

    <h2>What's Inside</h2>
    <p>
      Each phase below links to its plays on the site, if you'd rather
      read them individually before downloading the full compiled guide.
    </p>

    {phases.map((phase) => (
      <div class="phase-block">
        <div class="phase-block__label">{phase.label}</div>
        <h3>{phase.title}</h3>
        <ul>
          {phase.plays.map((play) => (
            <li><a href={`/playbook/${play.slug}/`}>{play.title}</a></li>
          ))}
        </ul>
      </div>
    ))}

    <p class="bottom-links">
      Prefer to browse individual plays? Visit the{' '}
      <a href="/playbook/">Playbook index</a>. Or read the strategic case
      for a program in{' '}
      <a href="/topics/how-to-build-win-loss-program/">How to Build a Win/Loss Research Program</a>.
    </p>
  </article>
</BaseLayout>

<style>
  .direct-answer {
    padding-left: var(--space-5);
    border-left: 3px solid var(--gold);
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
    color: var(--text-answer-color);
    border-bottom: 1px solid var(--paper-2);
    padding-bottom: 2.25rem;
    margin-bottom: var(--space-8);
  }

  .pdf-preview {
    display: flex;
    gap: var(--space-8);
    align-items: flex-start;
    background: var(--paper-2);
    border-radius: var(--radius-md);
    padding: var(--space-8);
    margin-bottom: var(--space-8);
  }

  .pdf-preview__image {
    flex: 0 0 200px;
    width: 200px;
    height: auto;
    border: 1px solid var(--muted);
    border-radius: var(--radius-sm);
  }

  .pdf-preview__copy {
    flex: 1;
    min-width: 0;
  }

  .pdf-preview__copy h3 {
    margin-top: 0;
  }

  .pdf-preview__meta {
    font-family: var(--font-mono);
    font-size: 0.71875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
    margin: 0 0 var(--space-4);
  }

  .download-button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--gold);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 15px 26px;
    border-radius: var(--radius-sm);
    border-bottom: none;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .download-button:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .download-button svg {
    width: 16px;
    height: 16px;
    flex: none;
  }

  .download-note {
    font-family: var(--font-mono);
    font-size: 0.71875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
    margin-top: var(--space-3);
    margin-bottom: 0;
  }

  .phase-block {
    margin-top: var(--space-8);
  }

  .phase-block__label {
    font-family: var(--font-mono);
    font-size: 0.71875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--gold);
    font-weight: 600;
    margin-bottom: var(--space-2);
  }

  .phase-block h3 {
    margin-bottom: var(--space-3);
  }

  .phase-block ul {
    margin-bottom: 0;
  }

  .bottom-links {
    margin-top: var(--space-10);
    padding-top: var(--space-6);
    border-top: 1px solid var(--paper-2);
    font-size: var(--text-sm);
    color: var(--muted);
    font-family: var(--font-mono);
  }

  .bottom-links a {
    color: var(--muted);
    border-bottom: 1px solid var(--muted);
  }

  .bottom-links a:hover {
    color: var(--gold);
    border-bottom-color: var(--gold);
  }

  @media (max-width: 640px) {
    .pdf-preview {
      flex-direction: column;
    }

    .pdf-preview__image {
      flex: none;
      width: 140px;
    }
  }
</style>
