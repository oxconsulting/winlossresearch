---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PILLAR_SLUGS } from '../../content.config';

const pillarPages = await getCollection('pillars');
const pillarsById = Object.fromEntries(pillarPages.map((p) => [p.id, p]));

// Canonical Pillar 1 -> 10 order, matching PILLAR_SLUGS in content.config.ts
// and the homepage's pillar-grid section, rather than alphabetical (the
// prior baseline sort). Alphabetical order scrambled the site's intended
// thematic build-up: foundational argument -> mechanism -> methodology ->
// applications -> the capstone how-to-build-a-program pillar.
const pillars = PILLAR_SLUGS.map((slug) => pillarsById[slug]).filter(Boolean);
---

<BaseLayout
  title="Topics"
  description="The ten core topics in win/loss research — from why internal data fails to how to build a program that produces defensible findings."
>
  <h1>Topics</h1>
  <p>Ten pillars covering the full scope of win/loss research methodology, competitive intelligence, and GTM strategy.</p>

  <section class="pillar-grid" aria-label="All topics">
    <ul class="pillar-grid__list">
      {
        pillars.map((pillar) => (
          <li class="pillar-grid__item">
            <a href={`/topics/${pillar.id}/`}>{pillar.data.title}</a>
            <p>{pillar.data.description}</p>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
